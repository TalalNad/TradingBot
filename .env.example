# Copy this file to .env and edit the values.
# Keep DRY_RUN=true while testing the webhook locally.
DRY_RUN=true

# Use the same secret in the TradingView Pine Script input.
WEBHOOK_SECRET=change-this-secret

# Binance Spot Testnet only:
# https://testnet.binance.vision/
BINANCE_BASE_URL=https://testnet.binance.vision
BINANCE_API_KEY=put-your-testnet-api-key-here
BINANCE_API_SECRET=put-your-testnet-api-secret-here

# Trade defaults used when the webhook payload omits symbol or quantity.
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_QUANTITY=0.001

HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false

LOG_FILE=logs/bot.log
ALERTS_FILE=data/alerts.jsonl
TRADES_FILE=data/trades.csv
